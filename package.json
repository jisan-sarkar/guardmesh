{
  "name": "guardmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Security-focused distributed-systems reference implementation",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --recursive --if-present build",
    "policy:test": "opa test packages/guardmesh-policy/policy",
    "compose:config": "docker compose --env-file .env.example config"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  }
}
