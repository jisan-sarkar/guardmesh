POSTGRES_USER=guardmesh
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=guardmesh
DATABASE_URL=postgresql://guardmesh:change-me-local-only@postgres:5432/guardmesh
ORDERS_DATABASE_URL=postgresql://orders_app:orders-change-me-local-only@postgres:5432/guardmesh
INVENTORY_DATABASE_URL=postgresql://inventory_app:inventory-change-me-local-only@postgres:5432/guardmesh
SECURITY_DATABASE_URL=postgresql://security_app:security-change-me-local-only@postgres:5432/guardmesh
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
OIDC_ISSUER=http://localhost:8080/realms/guardmesh
OIDC_AUDIENCE=guardmesh-api
OIDC_JWKS_URI=http://keycloak:8080/realms/guardmesh/protocol/openid-connect/certs
OPA_POLICY_URL=http://opa:8181/v1/data/guardmesh/authorization/decision
RABBITMQ_URL=amqp://orders-service:orders-change-me-local-only@rabbitmq:5672/guardmesh
ORDERS_RABBITMQ_URL=amqp://orders-service:orders-change-me-local-only@rabbitmq:5672/guardmesh
INVENTORY_RABBITMQ_URL=amqp://inventory-service:inventory-change-me-local-only@rabbitmq:5672/guardmesh
SECURITY_RABBITMQ_URL=amqp://security-service:security-change-me-local-only@rabbitmq:5672/guardmesh
# Set to http://otel-collector:4318 only when the observability profile is enabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
ACTOR_DIRECTORY_JSON={"cashier-1":{"roles":["cashier"],"locationId":"loc-a"},"manager-1":{"roles":["manager"],"locationId":"loc-a"},"operator-1":{"roles":["security-operator","security-producer"],"locationId":"loc-a"},"orders-service":{"roles":["inventory-reader"],"locationId":"loc-a"}}
